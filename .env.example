# ============================================================
# MY ZONE DASHBOARD — ENVIRONMENT CONFIGURATION
# ============================================================

# Server Port
PORT=8000

# Scraper Interval in Hours
SCRAPE_INTERVAL_HOURS=24

# ------------------------------------------------------------
# MAKE.COM / BUFFER / TWITTER WEBHOOK INTEGRATION
# ------------------------------------------------------------
# URL of your Make.com (Integromat) or Buffer webhook scenario.
# When the AI assistant is asked to post or tweet, it dispatches
# the payload to this webhook URL.
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-custom-webhook-id

# ------------------------------------------------------------
# AI CHATBOT LLM ENGINE (OPTIONAL)
# ------------------------------------------------------------
# If configured, the AI Assistant will use live LLM models for
# reasoning and intent determination. If left blank, the built-in
# zero-dependency natural language intent engine is used.

# OpenAI API Key (e.g. gpt-4o-mini or gpt-3.5-turbo)
OPENAI_API_KEY=

# OpenAI Model Name (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (e.g. gemini-1.5-flash)
GEMINI_API_KEY=
